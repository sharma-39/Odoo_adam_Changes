<odoo>
    <record id="view_product_template_form_inherit_labour" model="ir.ui.view">
        <field name="name">product.template.form.labour.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Place field before supplier_taxes_id -->
            <xpath expr="//field[@name='supplier_taxes_id']" position="before">
                <field name="x_studio_product_labour_cost" string="Labour Cost"/>
            </xpath>
        </field>
    </record>
</odoo>
