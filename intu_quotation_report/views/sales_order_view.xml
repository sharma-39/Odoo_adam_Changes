<odoo>
    <record id="sale_order_form_custom_report" model="ir.ui.view">
        <field name="name">sale.order.form.custom.report</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
	<xpath expr="//button[@name='sale.action_report_saleorder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button
                    name="%(action_report_custom_quotation)d"
                    string="Print"
                    type="action"
                    class="btn-primary"/>
            </xpath>

        </field>
    </record>
</odoo>
