<odoo>
<template id="quotation_report">
  <t t-call="intu_quotation_report.web_external_layout_quotation">
    <t t-foreach="docs" t-as="doc">
      <t t-set="o" t-value="docs"/>
       <xpath expr="//t[@t-set='o']" position="after">
        <!-- Set Flag Variable -->
        <t t-set="approved_flag" t-value="o.x_approved_widget_enable"/>
      </xpath>
      <main>
      <div class="page" style="position: relative;">
        <!-- ================== COMMON CSS ================== -->
        <style>
          span.ingredient {
            font-weight: 700;
            color: #000000;
            font-size: 14px;
          }

          td.ingredient {
            font-weight: 700;
            color: #000000;
            font-size: 14px;
          }

          .watermark {
            position: absolute;
            /* fixed works best for Odoo PDF */
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            -webkit-transform: translate(-50%, -50%) rotate(-45deg);
            transform-origin: center center;
            -webkit-transform-origin: center center;
            opacity: 0.1;
            color: #000;
            font-weight: bold;
            white-space: nowrap;
            pointer-events: none;
            z-index: 0;
            text-align: center;
          }

          .watermark-text {
            position: absolute;
            /* fixed works best for Odoo PDF */
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            -webkit-transform: translate(-50%, -50%) rotate(-45deg);
            transform-origin: center center;
            -webkit-transform-origin: center center;
            opacity: 0.1;
            font-size: 150px;
            color: #000;
            font-weight: bold;
            white-space: nowrap;
            pointer-events: none;
            z-index: 0;
            text-align: center;
          }

          /* Make sure content goes above watermark */
          .page-content {
            position: relative;
            z-index: 1;
          }

          table.qtn-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;

            /* ✅ Prevent table from splitting across pages */
          }

          table.qtn-table th,
          table.qtn-table td {
            border: 2px solid #000;
            padding: 6px;
          }

          table.qtn-table thead {
            display: table-header-group;
            /* ✅ Ensures table header repeats on next page if needed */
          }

          table.qtn-table tbody {
            display: table-row-group;
          }

          table.qtn-table tr {
            page-break-inside: avoid;
            /* ✅ Prevents individual rows from breaking */
            page-break-after: auto;
          }

          table.qtn-table thead th {
            background: #f2f2f2;
            text-align: center;
            font-weight: bold;
          }

          table.qtn-table .section-header {
            background-color: #00B0F0;
            color: black;
            font-weight: bold;
            text-align: center;
            font-size: 15px;
            padding-left: 10px !important;
            text-transform: uppercase;
          }

          table.qtn-table .section-header_summary {
            background-color: #714b67;
            color: white;
            text-align: center;
            font-weight: bold;
            font-size: 15px;
            text-transform: uppercase;
          }

          table.qtn-table td.num {
            text-align: center;
          }

          table.qtn-table td.amount {
            text-align: right;
          }

          table.qtn-table .total-row td {
            font-weight: bold;
          }

          /* ✅ Optional: keep summary together */
          .summary-section {
            page-break-inside: avoid;
            /* Keeps the entire summary block on one page */
            margin-top: 20px;
          }
        </style>
        <t t-if="o.state == 'cancel'">
          <div class="watermark-text">Cancelled Quotation</div>
        </t>
        <t t-elif="o.state == 'sale' and approved_flag ">
          <div class="watermark">
       <img t-if="doc.company_id.logo"
     style="-webkit-transform:scale(1.5);"
     t-att-src="image_data_uri(doc.company_id.logo)"
     alt="Logo"/>
          </div>
        </t>
        <t t-elif="o.state != 'sale' and approved_flag">
          <div class="watermark">
  <img t-if="doc.company_id.logo"
     style="-webkit-transform:scale(1.5);"
     t-att-src="image_data_uri(doc.company_id.logo)"
     alt="Logo"/>
          </div>
        </t>
        <t t-else="not approved_flag and o.state not in ['sale','cancel']">
          <div class="watermark-text">Draft Quotation</div>
        </t>
        <div style="font-size: 25px; text-align:center; font-weight:bold; text-decoration:underline; margin-bottom:15px;">
          <!-- Cancel -->
          <t t-if="o.state == 'cancel'">Cancelled Quotation</t>
          <t t-if="o.state == 'sale' and approved_flag">Quotation</t>
          <t t-if="o.state != 'sale' and approved_flag">Quotation</t>
          <t t-if="not approved_flag and o.state not in ['sale','cancel']">Draft Quotation</t>

          <!-- Draft -->
        </div>
        <!-- ================== PARTY INFO ================== -->
        <table class="qtn-table" style="width:100%; ">
          <tbody>
            <tr>
              <td style="width:65%; padding-left:10px !important">
                <span class="ingredient"> To:</span>
                <t t-esc="doc.partner_id.name"/>
              </td>
              <td style="white-space: nowrap;">
                <span class="ingredient">Quote No:</span>
                <t t-esc="doc.x_order_reference_number"/>
              </td>
            </tr>
            <t t-if="doc.name!='New'">
              <tr>
                <td colspan="2" style="width:65%; padding-left:10px !important">
                  <span class="ingredient">Job Order:</span>
                  <t t-esc="doc.name"/>
                </td>
              </tr>
            </t>
            <tr>
              <td style="width:65%; padding-left:10px !important">
                <span class="ingredient"> Attention To:</span>
                <t t-esc="doc.x_studio_attention_to"/>
              </td>
              <td>
                <span class="ingredient">Date:</span>
                <t t-esc="doc.date_order.strftime('%d-%m-%Y')"/>
              </td>
            </tr>
            <tr>
              <td colspan="2" style="padding-left:10px !important;width:40%!important">
                <span class="ingredient">Address:</span>
                <t t-esc="doc.partner_id.street or ''"/>
                <t t-if="doc.partner_id.street"/>
                <t t-esc="doc.partner_id.street2 or ''"/>
                <t t-if="doc.partner_id.street2"/>
                <t t-esc="doc.partner_id.city or ''"/>
                <t t-if="doc.partner_id.state_id">,
                  <t t-esc="doc.partner_id.state_id.name"/>
                </t>
                <t t-if="doc.partner_id.zip"> -
                  <t t-esc="doc.partner_id.zip"/>
                </t>
                <t t-if="doc.partner_id.country_id">
                  <t t-esc="doc.partner_id.country_id.name"/>
                </t>
              </td>
            </tr>
            <tr>
              <td style="padding-left:10px !important">
                <span class="ingredient">Contact:</span>
                <t t-esc="doc.partner_id.phone or ''"/>
              </td>
              <td style="">
                <t t-if="doc.partner_id.email">
                  <span class="ingredient">Email:</span>
                  <t t-esc="doc.partner_id.email"/>
                </t>
              </td>
            </tr>
            <tr>
              <td class="ingredient" style="width:65%; padding-left:10px !important">
                <span class="ingredient">Subject:</span>
                <t t-esc="doc.x_studio_subject or ''"/>
              </td>
              <td colspan="2" style="white-space: nowrap;">
                <span class="ingredient">Enquiry Reference :</span>
                <t t-esc="doc.x_client_ref_id"/>
              </td>
            </tr>
            <tr/>
            <tr/>
            <tr>
              <!--<td style="padding-left:10px !important">-->
              <!--  <span class="ingredient">PO Reference:</span>-->
              <!--  <t t-esc="doc.x_studio_po_reference or ''"/>-->
              <!--</td>-->
            </tr>
          </tbody>
        </table>
        <!-- ================== PREPARE SECTIONS LIST ================== -->
        <t t-set="sections" t-value="doc.order_line.filtered(lambda l: l.display_type == 'line_section' and l.name != 'Down Payments')"/>
        <!-- ========================================= -->
        <!--   CASE 1: NO SECTIONS → PRINT NORMAL LINES -->
        <!-- ========================================= -->
        <t t-if="not sections">
          <table class="qtn-table" style="margin-top:10px;">
            <thead>
              <tr>
                <th style="padding-left:10px">SL.NO</th>
                <th>ITEMS</th>
                <th>QTY</th>
                <th>UNIT</th>
                <th>UNIT PRICE</th>
                <th>TOTAL AMOUNT</th>
              </tr>
            </thead>
            <tbody>
              <t t-set="sl" t-value="1"/>
              <t t-foreach="doc.order_line.filtered(lambda l: not l.display_type)" t-as="l">
                <t t-if="'Down Payment' not in l.name and l.name not in 'Discount' and l.product_uom_qty!=0.0">
                  <tr>
                    <td class="num" style="padding-left:10px">
                      <t t-esc="sl"/>
                    </td>
                    <td>
                      <t t-esc="l.name"/>
                    </td>
                    <td class="num">
                      <t t-esc="int(l.product_uom_qty)"/>
                    </td>
                    <td class="num">
                      <t t-esc="l.product_uom_id.name"/>
                    </td>
                    <td class="amount">
                      <t t-esc="'{:.2f}'.format(l.price_unit)"/>
                    </td>
                    <td class="amount" style="  padding-right:10px;">
                      <t t-esc="'{:.2f}'.format(l.price_subtotal)"/>
                    </td>
                  </tr>
                  <t t-set="sl" t-value="sl + 1"/>
                </t>
              </t>
              <!--<tr class="total-row">-->
              <!--  <td colspan="5" style="text-align:right;font-weight:bold;">Total</td>-->
              <!--  <td class="amount" style="padding-right:15px;">-->
              <!--    <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(doc.amount_untaxed+ doc.x_studio_total_discount or 0.0, {'display_currency': doc.pricelist_id.currency_id})"/>-->
              <!--  </td>-->
              <!--</tr>-->
              <!--<t t-if="doc.x_studio_total_discount">-->
              <!--  <tr class="total-row">-->
              <!--    <td colspan="5" style="text-align:right;font-weight:bold;">Discount</td>-->
              <!--    <td class="amount" style="padding-right:15px;">-->
              <!--      <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(doc.x_studio_total_discount, {'display_currency': doc.pricelist_id.currency_id})"/>-->
              <!--    </td>-->
              <!--  </tr>-->
              <!--</t>-->
              <!-- VAT flag -->
              <!--<t t-set="include_vat" t-value="doc.x_studio_include_vat_in_print and doc.amount_tax"/>-->
              <!-- Final total based on VAT option -->
              <!--<t t-set="final_total" t-value="doc.amount_total if include_vat else (doc.amount_total - doc.amount_tax)"/>-->
              <!-- VAT Row -->
              <!--<t t-if="include_vat">-->
              <!--  <tr class="total-row">-->
              <!--    <td colspan="5" style="text-align:right;font-weight:bold;"> VAT (5%) </td>-->
              <!--    <td class="amount" style="padding-right:15px;">-->
              <!--      <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 doc.amount_tax,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>-->
              <!--    </td>-->
              <!--  </tr>-->
              <!--</t>-->
              <!-- Grand Total -->
              <!--<tr class="total-row">-->
              <!--  <td colspan="5" style="text-align:right;font-weight:bold;"> Grand Total </td>-->
              <!--  <td class="amount" style="padding-right:15px;">-->
              <!--    <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(             final_total,             {'display_currency': doc.pricelist_id.currency_id}         )"/>-->
              <!--  </td>-->
              <!--</tr>-->
              <!-- Amount in Words -->
              <!--<tr>-->
              <!--  <td colspan="6" style="font-size:16px;font-weight:bold;padding-left:10px;">-->
              <!--    <t t-set="amount_words" t-value="doc.pricelist_id.currency_id.amount_to_text(final_total)"/> Amount in Words:-->
              <!--    <t t-esc="amount_words"/> Only (-->
              <!--    <t t-esc="doc.pricelist_id.currency_id.name"/>)-->
              <!--  </td>-->
              <!--</tr>-->
              <!-- 1️⃣ Calculate helper flags -->
              <!-- 1️⃣ Helper variables -->

              <t t-set="discount_amount" t-value="doc.x_studio_total_discount or 0.0"/>
              <t t-set="tax_amount" t-value="doc.amount_tax or 0.0"/>
              <t t-set="include_vat" t-value="doc.x_studio_include_vat_in_print and tax_amount"/>
              <t t-set="show_grand_total" t-value="(discount_amount &gt; 0) or (tax_amount &gt; 0 and include_vat)"/>
              <t t-set="final_total" t-value="doc.amount_total if include_vat else (doc.amount_total - tax_amount)"/>
              <!-- 2️⃣ TOTAL row (always visible) -->
              <tr class="total-row">
                <td colspan="5" style="text-align:right;font-weight:bold;">Total</td>
                <td class="amount" style="padding-right:15px;">
                  <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(             doc.amount_untaxed + discount_amount,             {'display_currency': doc.pricelist_id.currency_id}         )"/>
                </td>
              </tr>
              <!-- 3️⃣ Discount row (only if discount > 0) -->
              <t t-if="discount_amount &gt; 0">
                <tr class="total-row">
                  <td colspan="5" style="text-align:right;font-weight:bold;">Discount</td>
                  <td class="amount" style="padding-right:15px;">
                    <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(discount_amount,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                  </td>
                </tr>
              </t>
              <!-- 4️⃣ VAT row (only if included and tax > 0) -->
              <t t-if="include_vat">
                <tr class="total-row">
                  <td colspan="5" style="text-align:right;font-weight:bold;">VAT (5%)</td>
                  <td class="amount" style="padding-right:15px;">
                    <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 tax_amount,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                  </td>
                </tr>
              </t>
              <!-- 5️⃣ Grand Total row (only if discount > 0 OR VAT included) -->
              <t t-if="show_grand_total">
                <tr class="total-row">
                  <td colspan="5" style="text-align:right;font-weight:bold;">Grand Total</td>
                  <td class="amount" style="padding-right:15px;">
                    <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 final_total,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                  </td>
                </tr>
              </t>
              <!-- 6️⃣ Amount in Words -->
              <tr>
                <td colspan="6" style="font-size:16px;font-weight:bold;padding-left:10px;">
                  <t t-set="amount_words" t-value="doc.pricelist_id.currency_id.amount_to_text(                final_total if show_grand_total else (doc.amount_untaxed + discount_amount)            )"/> Amount in Words:
                  <t t-esc="amount_words"/> Only (
                  <t t-esc="doc.pricelist_id.currency_id.name"/>)
                </td>
              </tr>
            </tbody>
          </table>
        </t>
        <t t-elif="sections">
          <!-- ================== SECTION WISE TABLES ================== -->
          <t t-foreach="sections" t-as="section">
            <t t-if="section.name != 'Down Payments'">
              <t t-set="next_seq_list" t-value="[s.sequence for s in sections if s.sequence &gt; section.sequence]"/>
              <t t-set="next_seq" t-value="min(next_seq_list) if next_seq_list else 999999999"/>
              <t t-set="section_lines" t-value="[l for l in doc.order_line if (not l.display_type)  and (l.sequence &gt; section.sequence) and (l.sequence &lt; next_seq)]"/>
              <t t-set="section_total" t-value="sum([l.price_subtotal for l in section_lines])"/>
              <table class="qtn-table" style="margin-top:10px;border-bottom:0px solid 1px; margin-bottom:-3px;">
                   <tr>
                    <th colspan="6" class="section-header">
                      <t t-esc="section.name"/>
                    </th>
                  </tr>
              </table>
              <table class="qtn-table" style="margin-top:0px;">
              <!--<table class="qtn-table" style="margin-top:10px;">-->
                <thead>
                  <!--<tr>-->
                  <!--  <th colspan="6" class="section-header">-->
                  <!--    <t t-esc="section.name"/>-->
                  <!--  </th>-->
                  <!--</tr>-->
                  <tr>
                    <th style="padding-left:5px !important">SL.NO</th>
                    <th>ITEMS</th>
                    <th>QTY</th>
                    <th>UNIT</th>
                    <th style="white-space: nowrap;">UNIT PRICE</th>
                    <th style="white-space: nowrap;">TOTAL AMOUNT</th>
                  </tr>
                </thead>
                <tbody>
                  <t t-set="inner_counter" t-value="0"/>
                  <t t-foreach="section_lines" t-as="l">
                    <t t-if=" l.name not in 'Discount' and l.product_uom_qty!=0.0">
                      <t t-set="inner_counter" t-value="inner_counter + 1"/>
                      <tr>
                        <td class="num">
                          <t t-esc="inner_counter"/>
                        </td>
                        <td style="width:70%">
                          <t t-esc="l.name"/>
                        </td>
                        <td class="num">
                          <t t-esc="int(l.product_uom_qty)"/>
                        </td>
                        <td class="num">
                          <t t-esc="l.product_uom_id.name"/>
                        </td>
                        <td class="amount">
                          <t t-esc="'{:.2f}'.format(l.price_unit)"/>
                        </td>
                        <td style="padding-right: 15px;" class="amount">
                          <t t-esc="'{:.2f}'.format(l.price_subtotal)"/>
                        </td>
                      </tr>
                    </t>
                  </t>
                  <tr class="total-row">
                    <t t-if="len(sections) &gt; 1">
                      <td colspan="5" style="text-align:right; font-weight: bold;">
                        <t t-if="len(sections) &gt; 1">Sub Total</t>
                      </td>
                      <td style="padding-right: 5px; font-weight: bold;" class="amount">
                        <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(section_total, {'display_currency': doc.pricelist_id.currency_id})"/>
                      </td>
                    </t>
                    <t t-if="len(sections) == 1">
                      <t t-set="discount_amount" t-value="doc.x_studio_total_discount or 0.0"/>
                      <t t-set="tax_amount" t-value="doc.amount_tax or 0.0"/>
                      <t t-set="include_vat" t-value="doc.x_studio_include_vat_in_print and tax_amount"/>
                      <t t-set="show_grand_total" t-value="(discount_amount &gt; 0) or (tax_amount &gt; 0 and include_vat)"/>
                      <t t-set="final_total" t-value="doc.amount_total if include_vat else (doc.amount_total - tax_amount)"/>
                      <!-- 2️⃣ TOTAL row (always visible) -->
                  <tr class="total-row">
                    <td colspan="5" style="text-align:right;font-weight:bold;">Total</td>
                    <td class="amount" style="padding-right:15px;">
                      <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(             doc.amount_untaxed + discount_amount,             {'display_currency': doc.pricelist_id.currency_id}         )"/>
                    </td>
                  </tr>
                  <!-- 3️⃣ Discount row (only if discount > 0) -->
                  <t t-if="discount_amount &gt; 0">
                    <tr class="total-row">
                      <td colspan="5" style="text-align:right;font-weight:bold;">Discount</td>
                      <td class="amount" style="padding-right:15px;">
                        <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 discount_amount,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                      </td>
                    </tr>
                  </t>
                  <!-- 4️⃣ VAT row (only if included and tax > 0) -->
                  <t t-if="include_vat">
                    <tr class="total-row">
                      <td colspan="5" style="text-align:right;font-weight:bold;">VAT (5%)</td>
                      <td class="amount" style="padding-right:15px;">
                        <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 tax_amount,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                      </td>
                    </tr>
                  </t>
                  <!-- 5️⃣ Grand Total row (only if discount > 0 OR VAT included) -->
                  <t t-if="show_grand_total">
                    <tr class="total-row">
                      <td colspan="5" style="text-align:right;font-weight:bold;">Grand Total</td>
                      <td class="amount" style="padding-right:15px;">
                        <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 final_total,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                      </td>
                    </tr>
                  </t>
                  <!-- 6️⃣ Amount in Words -->
                  <tr>
                    <td colspan="6" style="font-size:16px;font-weight:bold;padding-left:10px;">
                      <t t-set="amount_words" t-value="doc.pricelist_id.currency_id.amount_to_text(                final_total if show_grand_total else (doc.amount_untaxed + discount_amount)            )"/> Amount in Words:
                      <t t-esc="amount_words"/> Only (
                      <t t-esc="doc.pricelist_id.currency_id.name"/>)
                    </td>
                  </tr>
            </t>
            </tr>
            </tbody>
            </table>
          </t>
        </t>
        <t t-if="len(sections) &gt; 1">
             <table class="qtn-table" style="margin-top:10px;border-bottom:0px solid 1px; margin-bottom:-3px;">
            <tr>
                <th colspan="6" class="section-header_summary">SUMMARY</th>
              </tr>
              </table>
              <table class="qtn-table" style="margin-top:0px;">
            <thead>
              <!--<tr>-->
              <!--  <th colspan="6" class="section-header_summary">SUMMARY</th>-->
              <!--</tr>-->
              <tr>
                <th>SL.NO</th>
                <th>DESCRIPTION</th>
                <th>QTY</th>
                <th>UNIT</th>
                <th>UNIT PRICE</th>
                <th>TOTAL AMOUNT</th>
              </tr>
            </thead>
            <tbody>
              <t t-set="i" t-value="1"/>
              <t t-foreach="sections" t-as="section">
                <t t-if="section.name != 'Down Payments'">
                  <t t-set="next_seq_list2" t-value="[s.sequence for s in sections if s.sequence &gt; section.sequence]"/>
                  <t t-set="next_seq2" t-value="min(next_seq_list2) if next_seq_list2 else 999999999"/>
                  <t t-set="section_lines2" t-value="[l for l in doc.order_line if (not l.display_type)  and (l.sequence &gt; section.sequence) and (l.sequence &lt; next_seq2)]"/>
                  <t t-set="section_total2" t-value="sum([l.price_subtotal for l in section_lines2])"/>
                  <tr>
                    <td class="num">
                      <t t-esc="i"/>
                    </td>
                    <td style="width:50%">
                      <t t-esc="section.name"/>
                    </td>
                    <td class="num">
                      <t t-esc="1"/>
                    </td>
                    <td class="num">
                      <t t-esc="section_lines2[0].product_uom_id.name if section_lines2 else ''"/>
                    </td>
                    <td class="amount">
                      <t t-esc="'{:.2f}'.format(section_total2)"/>
                    </td>
                    <td class="amount" style="padding-right:15px;">
                      <t t-esc="'{:.2f}'.format(section_total2)"/>
                    </td>
                  </tr>
                  <t t-set="i" t-value="i+1"/>
                </t>
              </t>
              <t t-set="discount_amount" t-value="doc.x_studio_total_discount or 0.0"/>
              <t t-set="tax_amount" t-value="doc.amount_tax or 0.0"/>
              <t t-set="include_vat" t-value="doc.x_studio_include_vat_in_print and tax_amount"/>
              <t t-set="show_grand_total" t-value="(discount_amount &gt; 0) or (tax_amount &gt; 0 and include_vat)"/>
              <t t-set="final_total" t-value="doc.amount_total if include_vat else (doc.amount_total - tax_amount)"/>
              <!-- 2️⃣ TOTAL row (always visible) -->
              <tr class="total-row">
                <td colspan="5" style="text-align:right;font-weight:bold;">Total</td>
                <td class="amount" style="padding-right:15px;">
                  <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(             doc.amount_untaxed + discount_amount,             {'display_currency': doc.pricelist_id.currency_id}         )"/>
                </td>
              </tr>
              <!-- 3️⃣ Discount row (only if discount > 0) -->
              <t t-if="discount_amount &gt; 0">
                <tr class="total-row">
                  <td colspan="5" style="text-align:right;font-weight:bold;">Discount</td>
                  <td class="amount" style="padding-right:15px;">
                    <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 discount_amount,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                  </td>
                </tr>
              </t>
              <!-- 4️⃣ VAT row (only if included and tax > 0) -->
              <t t-if="include_vat">
                <tr class="total-row">
                  <td colspan="5" style="text-align:right;font-weight:bold;">VAT (5%)</td>
                  <td class="amount" style="padding-right:15px;">
                    <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 tax_amount,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                  </td>
                </tr>
              </t>
              <!-- 5️⃣ Grand Total row (only if discount > 0 OR VAT included) -->
              <t t-if="show_grand_total">
                <tr class="total-row">
                  <td colspan="5" style="text-align:right;font-weight:bold;">Grand Total</td>
                  <td class="amount" style="padding-right:15px;">
                    <span t-raw="doc.env['ir.qweb.field.monetary'].value_to_html(                 final_total,                 {'display_currency': doc.pricelist_id.currency_id}             )"/>
                  </td>
                </tr>
              </t>
              <!-- 6️⃣ Amount in Words -->
              <tr>
                <td colspan="6" style="font-size:16px;font-weight:bold;padding-left:10px;">
                  <t t-set="amount_words" t-value="doc.pricelist_id.currency_id.amount_to_text(                final_total if show_grand_total else (doc.amount_untaxed + discount_amount)            )"/> Amount in Words:
                  <t t-esc="amount_words"/> Only (
                  <t t-esc="doc.pricelist_id.currency_id.name"/>)
                </td>
              </tr>
            </tbody>
          </table>
        </t>
    </t>
    <!-- ================== NOTES & SIGNATURE ================== -->
    <t t-if="doc.note">
      <div style="margin-top:20px; font-size:16px;">
        <span t-field="doc.note"/>
      </div>
    </t>
    </div>
      </main>
  </t>
  </t>
</template>
 </odoo>