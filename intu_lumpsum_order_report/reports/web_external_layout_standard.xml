<odoo>
<template id = "web_external_layout_standard">
  <style>
    .last-page-message {
      visibility: hidden;
      height: 0;
    }

    @page :last {
      .last-page-message {
        visibility: visible;
        height: auto;
      }
    }
  </style>
  <!-- HEADER -->
  <div class="header" style="">
    <img t-if="company.logo"  style="position:absolute; left:15px; top:10px; width:150px;"
             t-att-src="image_data_uri(company.logo)"
             alt="Logo"/>
    <!--</t>-->
  </div>
  <!-- BODY -->
  <div t-attf-class="article o_report_layout_standard o_table_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')" style="">
    <h2 t-out="layout_document_title" style="font-size:16px; font-weight:bold; margin:0;"/>
    <t t-out="0"/>
  </div>
  <!-- FOOTER -->
  <div class="footer o_company_#{company.id}_layout" style="width:100%; border-top:0px solid #000; padding-top:8px; text-align:center; font-size:10px; height:80px;">

    <div style="width:100%; font-size:12px;">
      <span style="float:left; font-size:10px; font-style:italic; white-space:nowrap;"> This is a computer-generated document. No signature or stamp required </span>
      <span style="float:right;" t-if="report_type == 'pdf'"> Page <span class="page"/> / <span class="topage"/></span>
    </div>

  </div>
</template>
  </odoo>