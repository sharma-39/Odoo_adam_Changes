<odoo>
    <record id="view_account_move_form_inherit_custom" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header/button[@name='action_print_pdf']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//header/button[@name='action_print_pdf']" position="after">
                <button name="%(action_report_custom_invoice)d"
                        string="Print"
                        type="action"
                        class="oe_highlight"
                        data-hotkey="y"/>
            </xpath>

        </field>
    </record>
</odoo>