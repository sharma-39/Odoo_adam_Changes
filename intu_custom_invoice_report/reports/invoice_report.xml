<odoo>
  <!-- ===============================
         Custom Quotation PDF Report
         =============================== -->
  <template id="report_custom_invoice">
     <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">

  <div class="page">
    <div class="oe_structure"/>
    <div class="footer" style="text-align:center; font-size:12px; margin-top:20px; color:#555;">
      <div style="width:100%; font-size:15px;">
        <span style="float:left; font-size:15px; font-style:italic; white-space:nowrap;"> This is a computer-generated document. No signature or stamp required </span>
        <span style="float:right;" t-if="report_type == 'pdf'"> Page <span class="page"/> / <span class="topage"/></span>
      </div>
    </div>
    <t t-set="doc" t-value="doc"/>
    <t t-set="bank" t-value="doc.partner_id.bank_ids and doc.partner_id.bank_ids[0] or False"/>
    <style>
      .section-header {
        background: #143e8a;
        color: #fff;
        font-weight: 700;
        padding: 6px 10px;
        font-size: 13px;
        display: inline-block;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        text-align: left !important;
        margin-top: 8px;
      }

      .invoice-label {
        color: #000;
        font-weight: bold;
        font-size: 13px;
      }

      .invoice-value {
        font-weight: 600;
        color: #000;
        font-size: 13px;
      }

      .invoice-field {
        display: flex;
        justify-content: space-between;
        margin-top: 2px;
      }

      table {
        width: 100%;
        font-size: 14px;
      }

      th {
        background-color: #143e8a;
        color: #fff;
        font-weight: 600;
        padding: 12px 7px;
        text-align: left;
        border: 1px solid #2980b9;
      }

      td {
        padding: 3px 3px;
        border: 1px solid #e0e0e0;
        text-align: center;
      }

      .parent {
        width: 100%;
        display: -webkit-box;
        /* OLD - iOS 6-, Safari 3.1-6 */
        display: -ms-flexbox;
        /* TWEENER - IE 10 */
        display: -webkit-flex;
        /* NEW - Chrome */
        display: flex;
        /* Standard */
        /* Optional: for visual check */
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        justify-content: space-between;
      }

      .left {
        flex: 1;
        width: 50%;
        /* equal width */
        box-sizing: border-box;
        /* padding doesn't affect width */
        padding: 5px;
        /* optional */
      }

      .right {
        flex: 1;
        width: 40%;
        /* equal width */
        box-sizing: border-box;
        /* padding doesn't affect width */
        padding: 5px;
        /* optional */
      }

      .left {
        text-align: left;
      }

      .right {
        white-space: nowrap;
        /* keep data in same line */
      }

      .invoice-field {
        display: flex;
        gap: 7px;
      }

      .invoice-label {
        width: 120px;
        /* adjust as needed */
        font-weight: bold;
      }

      .invoice-colon {
        width: 10px;
      }

      .no-border-table {
        border: 0px solid transparent !important;
        -webkit-border: 0px solid transparent !important;
        border-collapse: separate !important;
        /* IMPORTANT FIX */
      }

      .no-border-table td,
      .no-border-table tr {
        text-align: left;
        border: none !important;
        -webkit-border: none !important;
        box-shadow: none !important;
      }
    </style>
    <div class="parent">
      <div class="left">
        <div>
                 <img t-if="doc.company_id.logo"
    style="max-width:650px; margin:2px;"
     t-att-src="image_data_uri(doc.company_id.logo)"
     alt="Logo"/>

        </div>
        <div style="font-size:20px">
          <strong>
            <t t-esc="doc.company_id.name"/>
          </strong>
        </div>
        <!--Address and Contact Details -->
        <div/>
        <table class="no-border-table">
          <!-- Address Fields (single row or multiple td) -->
          <tr>
            <t t-if="doc.company_id.street">
              <td colspan="3" t-esc="doc.company_id.street"/>
            </t>
          </tr>
         <tr>
            <t t-if="doc.company_id.street">
              <td colspan="3" t-esc="doc.company_id.street2"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.company_id.city">
              <td colspan="3" t-esc="doc.company_id.city"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.company_id.state_id">
              <td colspan="3" t-esc="doc.company_id.state_id.name"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.company_id.country_id">
              <td colspan="3" t-esc="doc.company_id.country_id.name"/>
            </t>
          </tr>
          <!-- Contact Fields with Label + Colon + Value -->
          <tr>
            <t t-if="doc.company_id.phone">
              <td class="invoice-label">Phone</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.company_id.phone"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.company_id.zip">
              <td class="invoice-label">PO BOX</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.company_id.zip"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.company_id.email">
              <td class="invoice-label">Email</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.company_id.email"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.company_id.website">
              <td class="invoice-label">Website</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.company_id.website"/>
            </t>
          </tr>
        </table>
        <!-- Address and Contact Details -->
      </div>
      <div class="right">
        <div style="font-weight: bold; color:  #143e8a; font-size: 25px;text-transform: uppercase; border-bottom: 1px solid black;"> Tax Invoice </div>
        <div class="section-header">BANK DETAILS</div>
        <table class="no-border-table" style="width: 100%; ">
          <tr>
            <td style="font-weight:bold; text-align:left">Beneficiary Name</td>
            <td style="width:10px;">:</td>
            <td>
              <t t-esc="doc.partner_bank_id.acc_holder_name or ''"/>
            </td>
          </tr>
          <tr>
            <td style="font-weight:bold;text-align:left">Bank Name</td>
            <td>:</td>
            <td>
              <t t-esc="doc.partner_bank_id.bank_id.name or ''"/>
            </td>
          </tr>
          <tr>
            <td style="font-weight:bold;text-align:left">Account Number</td>
            <td>:</td>
            <td>
              <t t-esc="doc.partner_bank_id.acc_number or ''"/>
            </td>
          </tr>
          <tr>
            <td style="font-weight:bold;text-align:left">IBAN</td>
            <td>:</td>
            <td>
              <t t-esc="doc.partner_bank_id.bank_bic or ''"/>
            </td>
          </tr>
          <tr>
            <td style="font-weight:bold;text-align:left">TRN</td>
            <td>:</td>
            <td>
              <t t-esc="doc.company_id.vat or ''"/>
            </td>
          </tr>
        </table>
        <br/>
      </div>
    </div>
    <div class="parent">
      <div class="left">
        <div class="section-header">BILL TO</div>
        <div style="">
          <strong>
            <t t-esc="doc.partner_id.name"/>
          </strong>
        </div>
        <table class="no-border-table">
          <!-- Address Fields -->
          <tr>
            <t t-if="doc.partner_id.street">
              <td colspan="3" t-esc="doc.partner_id.street"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.partner_id.street2">
              <td colspan="3" t-esc="doc.partner_id.street2"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.partner_id.city">
              <td colspan="3" t-esc="doc.partner_id.city"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.partner_id.state_id">
              <td colspan="3" t-esc="doc.partner_id.state_id.name"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.partner_id.country_id">
              <td colspan="3" t-esc="doc.partner_id.country_id.name"/>
            </t>
          </tr>
          <!-- Contact Fields with Label + Colon + Value -->
          <tr>
            <t t-if="doc.partner_id.phone">
              <td class="invoice-label">Phone</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.partner_id.phone"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.partner_id.zip">
              <td class="invoice-label">PO BOX</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.partner_id.zip"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.partner_id.email">
              <td class="invoice-label">Email</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.partner_id.email"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.partner_id.website">
              <td class="invoice-label">Website</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.partner_id.website"/>
            </t>
          </tr>
          <tr>
            <t t-if="doc.partner_id.vat">
              <td class="invoice-label">TRN NO</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.partner_id.vat"/>
            </t>
          </tr>
        </table>
      </div>
      <div class="right">
        <div class="section-header">INVOICE DETAILS</div>
        <table class="no-border-table">
          <tr>
            <td class="invoice-label">INVOICE NO</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.name or ''"/>
          </tr>
          <tr>
            <td class="invoice-label">INVOICE DATE</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.invoice_date or ''"/>
          </tr>
       <tr>
    <td class="invoice-label">JOB NO</td>
    <td class="invoice-colon">:</td>

    <td>
        <t t-if="doc.x_studio_print_jod_as_customer_ref == 'source_document'">
            <t t-esc="doc.invoice_origin"/>
        </t>
        <t t-else="">
            <t t-esc="doc.ref"/>
        </t>
    </td>
</tr>

          <tr>
            <td class="invoice-label">PO NO</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.invoice_line_ids                     and doc.invoice_line_ids[0].sale_line_ids                     and doc.invoice_line_ids[0].sale_line_ids[0].order_id.x_studio_po_reference                     or 'N/A'"/>
          </tr>
          <tr>
            <td class="invoice-label">PAYMENT TERMS</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.invoice_line_ids                     and doc.invoice_line_ids[0].sale_line_ids                     and doc.invoice_line_ids[0].sale_line_ids[0].order_id.payment_term_id                     and doc.invoice_line_ids[0].sale_line_ids[0].order_id.payment_term_id.name                     or 'N/A'"/>
          </tr>
          <tr>
            <td class="invoice-label">SALES PERSON</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.user_id.name or 'N/A'"/>
          </tr>
        </table>
      </div>
    </div>
    <table>
      <thead>
        <tr>
          <th style="width:5%;text-align: center;!important">S.NO</th>
          <th style="width:65%">Description</th>
          <th>Unit</th>
          <th>Qty</th>
          <th style="text-align: right;!important;white-space: nowrap;">Unit Price</th>
          <th style="text-align: right;!important;text-wrap: nowrap;width:20% ">Total Amount</th>
        </tr>
      </thead>
<tbody>
    <t t-set="serial" t-value="1"/>
    <t t-foreach="doc.invoice_line_ids.sorted(key='sequence')" t-as="line">
        <!-- Section Header -->
        <t t-if="line.display_type == 'line_section'">
            <tr style="background-color:#f2f2f2; font-weight:bold; text-align:left !important; ">
                <td colspan="6" style="text-align:left !important; ">
                    <t t-esc="line.name"/>
                </td>
            </tr>
        </t>

        <!-- Regular Lines -->
        <t t-if="line.display_type != 'line_section'">
            <t t-if="line.name not in 'Discount' ">
            <tr>
                <td><t t-esc="serial"/></td>
                <td style="text-align:left !important;"><t t-esc="line.name or ''"/></td>
                <td style="text-align:right !important;"><t t-esc="line.product_uom_id.name or ''"/></td>
                <td style="text-align:right !important;"><t t-esc="'{:.2f}'.format(line.quantity or 0)"/></td>
                <td style="text-align:right !important;"><t t-esc="'{:.2f}'.format(line.price_unit or 0.0)"/></td>
                <td style="text-align:right !important;"><t t-esc="'{:.2f}'.format(line.price_subtotal or 0.0)"/></td>
            </tr>

            <t t-set="serial" t-value="serial + 1"/>
            </t>
        </t>
    </t>

    <!-- Totals -->
    <tr>
        <td colspan="2" rowspan="3" style="text-align:center; vertical-align:middle; font-weight:bold;">
            <t t-set="amount_words" t-value="doc.currency_id.amount_to_text(doc.amount_total)"/>
            Amount in Words: <strong><t t-esc="amount_words"/> Only (<t t-esc="doc.currency_id.name"/>)</strong>
        </td>
        <td colspan="3" style="font-weight:bold; text-align:left !important;">TOTAL BEFORE VAT</td>
        <td style="text-align:right !important; font-weight:bold;text-wrap: nowrap;">
            <span t-esc="'{:,.2f} {}'.format(doc.amount_untaxed or 0.0, doc.currency_id.symbol or '')"/>
        </td>
    </tr>
    <tr>
        <td colspan="3" style="font-weight:bold; text-align:left !important;">VAT</td>
        <td style="text-align:right !important; font-weight:bold;text-wrap: nowrap;">
            <span t-esc="'{:,.2f} {}'.format(doc.amount_tax or 0.0, doc.currency_id.symbol or '')"/>
        </td>
    </tr>
    <tr>
        <td colspan="3" style="font-weight:bold; text-align:left !important;">TOTAL AFTER VAT</td>
        <td style="text-align:right !important; font-weight:bold;text-wrap: nowrap !important">
            <span t-esc="'{:,.2f} {}'.format(doc.amount_total or 0.0, doc.currency_id.symbol or '')"/>
        </td>
    </tr>
</tbody>


    </table>
    <t t-if="doc.narration">
      <div style="margin-top:20px; font-size:14px;">
        <span t-field="doc.narration"/>
      </div>
    </t>
  </div>
  <table>
    <tbody>
      <tr>
        <td colspan="8" style="padding: 40px; width: 100%;">
          <div style="width:100%; font-size:13px; overflow:hidden; page-break-inside: avoid;">
            <div style="float:left; width:33.33%; text-align:left;">Prepared by, <br/>
              <strong>
                <t t-esc="(doc.user_id.name or '').upper()"/>
              </strong>
            </div>
            <div style="float:left; width:33.33%; text-align:center;">Approved by,</div>
            <div style="float:left; width:33.33%; text-align:right;">Original Received by</div>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
        </t>
      </t>
     </t>
  </template>
</odoo>