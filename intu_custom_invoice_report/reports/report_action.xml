<odoo>

    <!-- ===============================
         Paper Format : invoice
         =============================== -->
    <record id="paperformat_invoice" model="report.paperformat">
        <field name="name">invoice Format</field>

        <!-- A4 -->
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>

        <!-- Margins (mm) -->
        <field name="margin_top">5</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>

        <!-- Header -->
        <field name="header_line">False</field>
        <field name="header_spacing">35</field>

        <!-- PDF -->
        <field name="dpi">90</field>
        <field name="disable_shrinking">False</field>
    </record>

    <!-- ===============================
         Report Action : Custom invoice
         =============================== -->
    <record id="action_report_custom_invoice" model="ir.actions.report">
        <field name="name">invoice Report Custom</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">intu_custom_invoice_report.report_custom_invoice</field>
        <field name="report_file">intu_custom_invoice_report.report_custom_invoice</field>

        <!-- 🔗 Link paper format -->
        <field name="paperformat_id" ref="intu_custom_invoice_report.paperformat_invoice"/>

        <field name="print_report_name">'Invoice Statement - %s' % object.display_name</field>

    </record>

</odoo>
