<odoo>

    <!-- list VIEW -->
    <record id="view_x_mr_wizard_list" model="ir.ui.view">
        <field name="name">x.mr.wizard.list</field>
        <field name="model">x_mr_wizard</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="x_name"/>
                <field name="x_studio_mr_number" />
                <field name="x_studio_dr_number"/>
                <field name="x_studio_project"/>
                <field name="x_studio_responsibility"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_x_mr_wizard_form" model="ir.ui.view">
        <field name="name">x.mr.wizard.form</field>
        <field name="model">x_mr_wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                              <field name="x_studio_job_order_no"/>
                              <field name="x_studio_project"/>
                        </group>

                        <group>
                          <field name="x_studio_mr_number"/><field name="x_studio_responsibility_emp"  widget="many2one_avatar"/>
                        </group>
                    </group>


                    <notebook>
                        <page string="Order Lines">
                            <field name="x_mr_wizard_line_ids_e1f04">
                                <list create="false" editable="bottom" delete="false">
                                    <field name="x_studio_sequence" widget="handle"/>
                                    <field name="x_studio_mr_name"/>
                                    <field name="x_studio_qty" readonly="1"/>
                                    <field name="x_studio_unit" readonly="1"/>
                                    <field name="x_studio_qty_on_hand"/>
                                    <field name="x_studio_vendor_1"/>
                                    <field name="x_studio_currency_id"/>
                                    <field name="x_studio_rfq_qty"/>
                                    <field name="x_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>



</odoo>