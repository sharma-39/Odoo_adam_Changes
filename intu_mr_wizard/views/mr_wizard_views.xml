<odoo>

    <!-- list VIEW -->
    <record id="view_x_mr_wizard_list" model="ir.ui.view">
        <field name="name">x.mr.wizard.list</field>
        <field name="model">x_mr_wizard</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_name"/>
                <field name="x_studio_mr_number"/>
                <field name="x_studio_dr_number"/>
                <field name="x_studio_project"/>
                <field name="x_studio_responsibility"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_x_mr_wizard_form" model="ir.ui.view">
        <field name="name">x.mr.wizard.form</field>
        <field name="model">x_mr_wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <group>
                              <field name="x_studio_job_order_no"/>
                              <field name="x_studio_project"/>
                        </group>

                        <group>
                          <field name="x_studio_mr_number"/>
                            <field name="x_studio_responsibility_emp"/>
                        </group>
                    </group>


                    <notebook>
                        <page string="Order Lines">
                            <field name="x_mr_wizard_line_ids_e1f04">
                                <list editable="bottom">
                                    <field name="x_studio_sequence" widget="handle"/>
                                    <field name="x_studio_mr_name"/>
                                    <field name="x_studio_qty"/>
                                     <field name="x_studio_unit"/>
                                    <field name="x_studio_qty_on_hand"/>
                                    <field name="x_studio_vendor_1"/>
                                    <field name="x_studio_currency_id"/>
                                    <field name="x_studio_rfq_qty"/>
                                    <field name="x_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_x_mr_wizard" model="ir.actions.act_window">
        <field name="name">MR Wizard</field>
        <field name="res_model">x_mr_wizard</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_x_mr_wizard_root"
              name="MR Wizard"
              sequence="10"/>

    <menuitem id="menu_x_mr_wizard"
              name="MR Wizard"
              parent="menu_x_mr_wizard_root"
              action="action_x_mr_wizard"
              sequence="1"/>

</odoo>