<odoo>
    <record id="view_mrp_bom_form_inherit_custom" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.custom</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">


             <xpath expr="/form//page[@name='miscellaneous']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>


             <xpath expr="/form//page[@name='operations']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
          <xpath expr="//field[@name='product_qty']" position="attributes">
            <attribute name="nolabel">1</attribute><attribute name="invisible">1</attribute>
        </xpath>
           <xpath expr="//field[@name='code']" position="replace">
               <field name="code" invisible="1"/>
           </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
               <attribute name="invisible">1</attribute>
           </xpath>
            <xpath expr="//field[@name='product_id']" position="replace">
               <field name="product_id" invisible="1"/>
           </xpath>
            <xpath expr="//field[@name='type']" position="replace">
               <field name="type" invisible="1"/>
           </xpath>

              <xpath expr="//field[@name='product_uom_id']" position="replace">
               <field name="product_uom_id" invisible="1"/>
           </xpath>
              <xpath expr="//field[@name='product_qty']" position="replace">
               <field name="product_qty" invisible="1"/>
           </xpath>


              <xpath expr="/form/sheet/group/group/field[@name='product_tmpl_id']" position="attributes">

    <attribute name="domain">["&amp;", "&amp;", ("categ_id.x_studio_bom_list", "=", True), ("x_studio_is_project_done", "=", False), ("x_studio_is_create_job_order", "=", False)]</attribute>
  </xpath>
            <!-- Change Label of product_tmpl_id -->
           <xpath expr="//field[@name='product_tmpl_id']" position="attributes">

    <attribute name="string">Job Order</attribute>
</xpath>

            <!-- Move code field below product_tmpl_id -->
            <xpath expr="//field[@name='product_tmpl_id']" position="after">
                <field name="code"/>
            </xpath>

            <xpath expr="/form//button[@name='707']" position="attributes">
    <attribute name="invisible">True</attribute>
  </xpath>
  <xpath expr="/form//button[@name='724']" position="attributes">
    <attribute name="invisible">True</attribute>
  </xpath>
            <!-- Move project_id below code -->
            <xpath expr="//field[@name='code']" position="after">
                <field name="project_id"/>
            </xpath>
            <xpath expr="//button[@name='707']" position="attributes">
            <attribute name="groups"></attribute>
            <attribute name="invisible">0</attribute>
        </xpath>

        <xpath expr="//button[@name='724']" position="attributes">
            <attribute name="invisible">0</attribute>
        </xpath>

            <xpath expr="/form//button[@name='724']" position="after">
                 <button name="goto_mr" type="object" class="oe_stat_button" icon="fa-edit" invisible="x_studio_mr_count == 0">
                     <field name="x_studio_mr_count" widget="statinfo" string="Material Request" options="{'format': false}"/>
                 </button>
            </xpath>


             <xpath expr="/form/sheet" position="before">
                <header>
                    <button name="action_approve_bom"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        invisible="x_studio_approve_enable"></button>
                    <button name="action_revise_bom"
                        type="object"
                        string="Revise"
                        class="oe_highlight"
                        invisible="not x_studio_approve_enable"></button>
                    <button name="action_create_mr_bom"
                        type="object"
                        string="Create MR"
                        class="oe_highlight"
                        invisible="not x_studio_approve_enable"></button>
                    <field name="x_status_bar" widget="statusbar" statusbar_visible="draft,approve"/>
                </header>
            </xpath>

        </field>
    </record>

    <record id="view_mrp_bom_form_inherit_lines" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.lines</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
         <xpath expr="/form//field[@name='bom_line_ids']" position="attributes">
    <attribute name="force_save">1</attribute>
    <attribute name="readonly">x_status_bar == "approve"</attribute>
  </xpath>
            <xpath expr="//field[@name='bom_line_ids']/list/field[@name='product_qty']" position="after">

                <field name="x_studio_mr_qty" readonly="1"/>
                <field name="x_studio_remarks"/>
            </xpath>

        </field>
    </record>

</odoo>