<odoo>

    <record id="seq_purchase_order_ref" model="ir.sequence">
        <field name="name">Purchase Order Custom Sequence</field>
        <field name="code">purchase.order.ref_seq</field>
        <field name="prefix">RFQ|%(year)s|</field>
        <field name="padding">6</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>
    <record id="seq_purchase_order_normal" model="ir.sequence">
        <field name="name">Purchase Order Normal</field>
        <field name="code">purchase.order.normal</field>
        <field name="prefix">PO|%(year)s|</field>
        <field name="padding">6</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
    </record>

</odoo>