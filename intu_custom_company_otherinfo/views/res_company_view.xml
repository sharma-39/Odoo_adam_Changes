<odoo>
    <record id="view_company_form_inherit_other_info" model="ir.ui.view">
        <field name="name">res.company.form.inherit.other.info</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <!-- Add New Notebook Page -->
            <xpath expr="//notebook" position="inside">
                <page string="Other Info">
                    <group>
                        <field name="x_studio_labour_cost"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
