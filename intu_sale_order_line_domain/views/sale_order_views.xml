<odoo>
<record id="view_sale_order_form_inherit_control" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.control</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">

          <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="readonly">state == 'sale'</attribute>
            </xpath>

        <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="attributes">
            <attribute name="readonly">state == 'sale'</attribute>
            <attribute name="force_save">1</attribute>
        </xpath>

        <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="attributes">
            <attribute name="readonly">parent.state == 'sale'</attribute>
            <attribute name="force_save">1</attribute>
        </xpath>

        <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
            <attribute name="readonly">0</attribute>
            <attribute name="force_save">1</attribute>
        </xpath>

    </field>
</record>
</odoo>