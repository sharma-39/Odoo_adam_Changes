<odoo>

    <!-- FORM VIEW -->
    <record id="view_order_form_inherit_custom_reference" model="ir.ui.view">
        <field name="name">sale.order.form.custom.reference</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Above Customer -->
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="x_order_reference_number"
                       readonly="1"
                       invisible="not x_order_reference_number"/>
            </xpath>

        </field>
    </record>


    <!-- TREE VIEW (Quotation + Orders) -->
    <record id="view_order_tree_inherit_order_ref" model="ir.ui.view">
        <field name="name">sale.order.tree.custom.reference</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="before">
                <field name="x_order_reference_number"/>
            </xpath>

        </field>
    </record>

</odoo>
