<odoo>
<record id="view_task_form_inherit_manager" model="ir.ui.view">
    <field name="name">project.task.form.inherit.manager</field>
    <field name="model">project.task</field>
    <field name="inherit_id" ref="project.view_task_form2"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='active']" position="after">
            <field name="x_studio_project_manager" widget="many2one_avatar" string="Project Manager"/>
        </xpath>
    </field>
</record>
</odoo>