<odoo>
    <record id="view_material_request_form" model="ir.ui.view">
        <field name="name">material.request.form</field>
        <field name="model">x_custom_form</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_create_rfq_bom"
                            type="object"
                            string="Create RFQ"
                            class="oe_highlight"/>

                    <button name="action_create_delivery_bom"
                            type="object"
                            string="Create Delivery"
                            class="oe_highlight"
                            invisible="1"/>

                    <field name="x_studio_selection_field_5i4_1j9oojl26"
                           widget="statusbar"
                           statusbar_visible="requested,partially_delivered,delivered"/>
                </header>

                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button icon="fa-truck"
                                type="action"
                                name="%(stock.action_picking_tree_all)d"
                                class="oe_stat_button"
                                invisible="x_studio_delivery_count == 0">
                            <field name="x_studio_delivery_count" widget="statinfo" string="Delivery Order"/>
                        </button>

                        <button icon="fa-edit"
                                type="action"
                                name="%(stock.action_picking_form)d"
                                class="oe_stat_button"
                                invisible="x_studio_delivery_count == 0"/>
                    </div>

                    <group>
                        <group>
                            <field name="x_name"/>
                            <field name="x_studio_mr_number"/>
                            <field name="x_studio_sale_order_number"/>
                            <field name="x_studio_project"/>
                            <field name="x_studio_mr_priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="x_studio_mr_date"/>
                            <field name="create_uid" readonly="1"/>
                            <field name="x_studio_expected_deadline"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Material Lines">
                            <field name="x_custom_form_line_ids">
                                <list editable="bottom">
                                    <field name="x_studio_sequence" widget="handle"/>
                                    <field name="x_studio_product"/>
                                    <field name="x_studio_remarks_1"/>
                                    <field name="x_studio_qty"/>
                                    <field name="x_studio_received_qty"/>
                                    <field name="x_studio_po_rfq_qty"/>
                                    <field name="x_studio_expected_deadline"/>
                                    <field name="x_studio_unit"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_material_request_list" model="ir.ui.view">
        <field name="name">material.request.list</field>
        <field name="model">x_custom_form</field>
        <field name="arch" type="xml">
            <list>
                <field name="x_studio_mr_number"/>
                <field name="x_studio_sale_order_number"/>
                <field name="x_studio_mr_date"/>
                <field name="x_studio_expected_deadline"/>
                <field name="x_studio_selection_field_5i4_1j9oojl26"
                       widget="badge"
                       decoration-info="x_studio_selection_field_5i4_1j9oojl26 == 'requested'"
                       decoration-success="x_studio_selection_field_5i4_1j9oojl26 == 'delivered'"/>
                <field name="x_studio_delivery_number"/>
                <field name="x_studio_purchase_count"/>
            </list>
        </field>
    </record>

    <record id="action_material_request" model="ir.actions.act_window">
        <field name="name">Material Request</field>
        <field name="res_model">x_custom_form</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_project_hub_root"
              name="Project Hub"
              parent="project.menu_main_pm"
              sequence="40"/>

    <menuitem id="menu_project_sub"
              name="Project"
              parent="menu_project_hub_root"
              sequence="10"/>

    <menuitem id="menu_material_request"
              name="Material Requests"
              parent="menu_project_sub"
              action="action_material_request"
              sequence="20"/>

</odoo>