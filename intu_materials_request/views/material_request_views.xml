<odoo>
    <record id="view_material_request_form" model="ir.ui.view">
        <field name="name">material.request.form</field>
        <field name="model">x_custom_form</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <button name="action_create_rfq_bom" type="object" string="Create RFQ" class="oe_highlight"/>
                    <button name="action_create_delivery_bom" type="object" string="Create Delivery" class="oe_highlight" invisible="1"/>
                    <field name="x_studio_selection_field_5i4_1j9oojl26" widget="statusbar" statusbar_visible="requested,partially_delivered,delivered"/>
                </header>

                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="goto_delivery_form" type="object" class="oe_stat_button" icon="fa-truck" invisible="x_studio_delivery_count == 0">
                            <field name="x_studio_delivery_count" widget="statinfo" string="Delivery Order" options="{'format': false}"/>
                        </button>
                         <button name="goto_rfq_form" type="object" class="oe_stat_button" icon="fa-edit" invisible="x_studio_purchase_count == 0">
                            <field name="x_studio_purchase_count" widget="statinfo" string="RFQ | PO" options="{'format': false}"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="x_studio_mr_number"/>
                            <field name="x_studio_sale_order_number"/>
                            <field name="x_studio_project"/>
                            <field name="x_studio_mr_priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="x_studio_mr_date"/>
                            <field name="create_uid" readonly="1"/>
                            <field name="x_studio_expected_deadline"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Material Lines">
                            <field name="x_custom_form_line_ids">
                                <list create="false" editable="bottom">
                                    <field name="x_studio_sequence" widget="handle"/>
                                    <field name="x_studio_product"/>
                                    <field name="x_studio_remarks_1"/>
                                    <field name="x_studio_qty"/>
                                    <field name="x_studio_received_qty"/>
                                    <field name="x_studio_po_rfq_qty"/>
                                    <field name="x_studio_expected_deadline"/>
                                    <field name="x_studio_unit" domain="[('id', 'in', x_studio_allowed_uom)]"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                  <chatter></chatter>
            </form>
        </field>
    </record>

    <record id="view_material_request_list" model="ir.ui.view">
        <field name="name">material.request.list</field>
        <field name="model">x_custom_form</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="x_studio_mr_number"/>
                <field name="x_studio_sale_order_number"/>
                <field name="x_studio_mr_date"/>
                <field name="x_studio_expected_deadline"/>
                <field name="x_studio_selection_field_5i4_1j9oojl26" string="Purchase Status" widget="badge" decoration-info="x_studio_selection_field_5i4_1j9oojl26 == 'requested'" decoration-warning="x_studio_selection_field_5i4_1j9oojl26 == 'partially_delivered'" decoration-success="x_studio_selection_field_5i4_1j9oojl26 == 'delivered'"/>
                <field name="x_studio_delivery_number"/>
                <field name="x_studio_purchase_count"/>
            </list>
        </field>
    </record>

    <record id="action_material_request" model="ir.actions.act_window">
        <field name="name">Material Request</field>
        <field name="res_model">x_custom_form</field>
        <field name="view_mode">list,form</field>
    </record>
     <menuitem id="menu_project_hub_root"
              name="Project Hub"
              parent="project.menu_main_pm"
              sequence="40"/>


    <menuitem id="menu_material_request"
              name="Material Requests"
              parent="menu_project_hub_root"
              action="action_material_request"
              sequence="20"/>


    <menuitem id="menu_material_request"
          name="Bill Of Materials"
          parent="menu_project_hub_root"
          action="mrp.mrp_bom_form_action"
          sequence="20"/>

    <menuitem id="menu_material_request"
              name="Material Requests"
              parent="menu_project_hub_root"
              action="action_material_request"
              sequence="20"/>


</odoo>