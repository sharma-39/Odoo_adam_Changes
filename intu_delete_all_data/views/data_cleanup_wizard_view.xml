<odoo>

    <record id="view_data_cleanup_wizard" model="ir.ui.view">
        <field name="name">data.cleanup.wizard.form</field>
        <field name="model">data.cleanup.wizard</field>
        <field name="arch" type="xml">

            <form string="Delete All Data">

                <group>

                    <div class="text-danger">
                        <b>WARNING: This will delete all transactional data</b>
                    </div>

                    <field name="confirm"/>

                </group>

                <footer>

                    <button name="action_delete_all_data"
                            type="object"
                            string="Delete Data"
                            class="btn btn-danger"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

</odoo>