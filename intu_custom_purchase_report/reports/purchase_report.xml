<odoo>
  <!-- ===============================
         Custom Quotation PDF Report
         =============================== -->
  <template id="report_custom_purchase">
     <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">

  <div class="page">
    <div class="oe_structure"/>
    <div class="footer" style="text-align:center; font-size:12px; margin-top:20px; color:#555;">
      <div style="width:100%; font-size:15px;">
        <span style="float:left; font-size:15px; font-style:italic; white-space:nowrap;"> This is a computer-generated document. No signature or stamp required </span>
        <span style="float:right;" t-if="report_type == 'pdf'"> Page <span class="page"/> / <span class="topage"/></span>
      </div>
    </div>
    <t t-set="doc" t-value="doc"/>
     <style>
      .remark_label {
        font-weight: 600;
        font-size: 13px;
        color: #000;
        margin-right: 4px;
      }

      .product_remark {
        margin-top: 4px;
        padding-left: 8px;
        font-size: 13px;
        color: #444;
        border-left: 2px solid #bfbfbf;
        line-height: 1.5;
      }
    </style>
    <style>
      .section-header {
        background: #143e8a;
        color: #fff;
        font-weight: 700;
        padding: 6px 30px;
        font-size: 13px;
        display: inline-block;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        text-align: left !important;
        margin-top: 8px;
      }

      .section-header_summary {
        background-color: #714b67;
        color: white;
        text-align: left;
        font-weight: bold;
        font-size: 15px;
        text-transform: uppercase;
      }

      .invoice-label {
        color: #000;
        font-weight: bold;
        font-size: 13px;
      }

      .invoice-value {
        font-weight: 600;
        color: #000;
        font-size: 13px;
      }

      .invoice-field {
        display: flex;
        justify-content: space-between;
        margin-top: 2px;
      }

      table {
        width: 100%;
        font-size: 14px;
      }

      th {
        background-color: #143e8a;
        color: #fff;
        font-weight: 600;
        padding: 12px 7px;
        text-align: left;
        border: 1px solid #2980b9;
        font-weight: bold;
        text-transform: uppercase;
        vertical-align: middle;
      }

      td {
        padding: 1px 3px;
        border: 1px solid #e0e0e0;
        text-align: center;
        vertical-align: middle;
      }

      .parent {
        width: 100%;
        display: -webkit-box;
        /* OLD - iOS 6-, Safari 3.1-6 */
        display: -ms-flexbox;
        /* TWEENER - IE 10 */
        display: -webkit-flex;
        /* NEW - Chrome */
        display: flex;
        /* Standard */
        /* Optional: for visual check */
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        justify-content: space-between;
      }

      .left {
        width: 40%;
        -webkit-box-flex: 1;
        /* OLD */
        -ms-flex: 1;
        /* TWEENER */
        -webkit-flex: 1;
        /* NEW */
        flex: 1;
        /* Standard */
        padding: 10px;
        box-sizing: border-box;
        /* Ensures padding doesn't break width */
      }

      .right {
        width: 50%;
        -webkit-box-flex: 1;
        /* OLD */
        -ms-flex: 1;
        /* TWEENER */
        -webkit-flex: 1;
        /* NEW */
        flex: 1;
        /* Standard */
        padding: 10px;
        box-sizing: border-box;
        /* Ensures padding doesn't break width */
      }

      .left {
        text-align: left;
        white-space: nowrap;
        /* Optional */
      }

      .right {
        text-align: left;
        margin-left: 100px;
      }

      .invoice-field {
        display: flex;
        gap: 7px;
      }

      .invoice-label {
        width: 120px;
        /* adjust as needed */
        font-weight: bold;
      }

      .invoice-colon {
        width: 10px;
      }

      .no-border-table {
        border: 0px solid transparent !important;
        -webkit-border: 0px solid transparent !important;
        border-collapse: separate !important;
        /* IMPORTANT FIX */
      }

      .no-border-table td,
      .no-border-table tr {
        text-align: left;
        border: none !important;
        -webkit-border: none !important;
        box-shadow: none !important;
      }
    </style>
    <div class="parent">
      <div class="left">
        <div>

                     <img t-if="doc.company_id.logo"
     style="max-width:650px; margin:2px;"
     t-att-src="image_data_uri(doc.company_id.logo)"
     alt="Logo"/>
        </div>
        <b>
          <t t-esc="doc.company_id.name"/>
        </b>
        <br/>
        <t t-esc="doc.company_id.street or ''"/>
        <br/>
        <t t-esc="doc.company_id.street2 or ''"/>
        <br/>
        <t t-esc="doc.company_id.city or ''"/>
        <t t-if="doc.company_id.state_id">,
          <t t-esc="doc.company_id.state_id.name"/>
        </t>
        <t t-if="doc.company_id.zip"> -
          <t t-esc="doc.company_id.zip"/>
        </t>
        <br/>
        <t t-if="doc.company_id.partner_id.country_id">
          <t t-esc="doc.company_id.partner_id.country_id.name"/>
        </t>
        <br/>
        <t t-if="doc.company_id.email">
          <t t-esc="doc.company_id.email"/>
        </t>
        <br/>
        <t t-if="doc.company_id.website">
          <t t-esc="doc.company_id.website"/>
        </t>
        <br/>
          <t t-if="doc.company_id.vat">
            <span style="font-size:13px">TRN NO :  <t t-esc="doc.company_id.vat"/></span>
          </t>
      </div>
      <div class="right">
        <!--<div style="margin-left: 100px;text-align:center; font-family:'Times New Roman', serif; !important">-->
        <!--    <span style="    white-space: nowrap;     font-size:17px;         font-weight:bold;         color:#001f54;         letter-spacing:1px;         border-bottom:2px solid #9bbcd1;         display:inline-block;         padding-bottom:3px;     "> PURCHASE ORDER </span>-->
        <!--</div>-->
        <div class="section-header" style="margin-left: 100px;!important; white-space: nowrap; font-size:15px;">PURCHASE ORDER</div>
        <br/>
        <br/>
        <table>
          <t t-if="doc.name != 'New'">
            <tr>
              <td style="padding-left:10px !important;text-align:left">
                <span class="ingredient">
                  <strong>PO Number</strong>
                </span>
              </td>
              <td>
                <t t-esc="doc.name"/>
              </td>
            </tr>
          </t>
          <tr>
            <td style="text-align:left;padding-left:10px !important">
              <strong>RFQ Number</strong>
            </td>
            <td>
              <t t-esc="doc.x_studio_rfq_number or '' "/>
            </td>
          </tr>
          <tr>
            <td style="padding-left:10px !important;text-align:left">
              <span class="ingredient">
                <strong>Date</strong>
              </span>
            </td>
            <td>
              <t t-esc="doc.date_order.strftime('%d-%m-%Y')"/>
            </td>
          </tr>
        </table>
      </div>
    </div>
    <div class="parent" style="margin-top:-27px">
      <div class="left">
        <div class="section-header">VENDOR</div>
        <table class="no-border-table" style="font-size:14px; ;">
          <tr>
            <td colspan="9">
              <t t-if="doc.partner_id.name">
                <b>
                  <t t-esc="doc.partner_id.name"/>
                </b>
                <br/>
              </t>
              <t t-esc="doc.partner_id.street or ''"/>
              <t t-esc="doc.partner_id.street2 or ''"/>
              <br/>
              <t t-esc="doc.partner_id.city or ''"/>
              <t t-if="doc.partner_id.state_id">,
                <t t-esc="doc.partner_id.state_id.name"/>
              </t>
              <t t-if="doc.partner_id.zip"> -
                <t t-esc="doc.partner_id.zip"/>
              </t>
              <br/>
              <t t-if="doc.company_id.partner_id.country_id">
                <t t-esc="doc.company_id.partner_id.country_id.name"/>
              </t>
            </td>
          </tr>
          <tr t-if="doc.partner_id.phone">
            <td class="invoice-label">Phone Number</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.partner_id.phone"/>
          </tr>
          <tr t-if="doc.partner_id.email">
            <td class="invoice-label">Email</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.partner_id.email"/>
          </tr>
          <!-- VAT TRN NO -->
          <tr t-if="doc.partner_id.vat">
            <td class="invoice-label">VAT TRN NO</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.partner_id.vat"/>
          </tr>
        </table>
      </div>
      <div class="right">
        <div class="section-header">PROJECT DETAIL</div>
        <table class="no-border-table" style="font-size:14px; line-height:1.5;vertical-align: middle;">
          <!-- Project Code -->
          <t t-if="doc.project_id">
            <tr t-if="doc.x_studio_sales_order">
              <td class="invoice-label">Project Code</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.x_studio_sales_order.name or ''"/>
            </tr>
            <!-- MR Number -->
            <tr t-if="doc.x_studio_mr_number">
              <td class="invoice-label">MR Number</td>
              <td class="invoice-colon">:</td>
              <td t-esc="doc.x_studio_mr_number or ''"/>
            </tr>
          </t>
          <!-- Contact Person -->
          <tr t-if="doc.x_studio_responsibility">
            <td class="invoice-label">Contact Person</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.x_studio_responsibility.name or ''"/>
          </tr>
          <!-- Contact Number -->
          <tr t-if="doc.x_studio_responsibility.mobile_phone">
            <td class="invoice-label">Contact Number</td>
            <td class="invoice-colon">:</td>
            <td t-esc="doc.x_studio_responsibility.mobile_phone or ''"/>
          </tr>
        </table>
      </div>
    </div>
    <t t-set="discount_amount" t-value="abs((doc.x_studio_total_before_discount or 0.0) - (doc.amount_untaxed or 0.0))"/>
    <table style="padding: 3px 3px; !important">
      <thead>
        <tr>
          <th style="width:5%;text-align: center;!important">S.NO</th>
          <th style="width:75%;text-align:center!important">Description</th>
          <th>Unit</th>
          <th>Qty</th>
          <th style="text-align: right;!important;white-space: nowrap;">Unit Price</th>

           <t t-if="doc.x_studio_total_before_discount and abs(discount_amount) &gt; 0.0">
           <th style="text-align: right;!important;white-space: nowrap;">Total Amount</th>
          </t>
          <t t-else="">
            <th style="text-align: right;!important;white-space: nowrap;">Total Amount</th>
            <th>VAT Amount</th>
          <th>Net Total</th>
          </t>

        </tr>
      </thead>
      <tbody>

      <t t-if="doc.x_studio_total_before_discount and abs(discount_amount) &gt; 0.0">
        <t t-set="serial" t-value="1"/>
        <t t-foreach="doc.order_line" t-as="line">
          <t t-if="line.display_type == 'line_section' and not line.is_downpayment">
            <tr style="background-color:#f2f2f2; font-weight:bold; text-transform: uppercase;padding: 3px 3px; !important">
              <td colspan="8" style="padding: 3px 3px; !important;text-align:left;">
                <t t-esc="line.name"/>
              </td>
            </tr>
          </t>

          <t t-if="line.display_type != 'line_section' and not line.is_downpayment">
            <tr>
              <td style="padding: 3px 3px; !important">
                <t t-esc="serial"/>
              </td>
              <td style="text-align:left;padding: 3px 3px; !important">
                <t t-esc="line.name or ''"/>
                 <t t-if="line.x_studio_remarks">
                    <div class="product_remark">
                      <span class="remark_label">Remark:</span>
                      <t t-esc="line.x_studio_remarks"/>
                    </div>
                  </t>
              </td>
              <td style="text-align:center;padding: 3px 3px; !important">
                <t t-esc="line.product_uom_id.name or ''"/>
              </td>
              <td style="text-align:center;padding: 3px 3px; !important">
                <t t-esc="'{:.2f}'.format((line.product_qty) or 0)"/>
              </td>
              <td style="text-align:center;padding: 3px 3px; !important">
                <t t-esc="'{:.2f}'.format((line.price_unit) or 0.0)"/>
              </td>
              <t t-if="doc.x_studio_total_before_discount">
                <td class="amount" style=" padding-right:10px;">
                  <t t-esc="'{:.2f}'.format(int(line.product_qty) * line.price_unit)"/>
                </td>
              </t>
              <t t-else="">
                <td class="amount" style="text-align: right !important">
                  <t t-esc="'{:.2f}'.format(line.price_subtotal)"/>
                </td>
              </t>
              <!--<td style="text-align:right !important;padding: 3px 3px; !important">-->
              <!--  <t t-esc="'{:.2f}'.format((line.price_total- line.price_subtotal) or 0.0)"/>-->
              <!--</td>-->
              <!--<t t-if="doc.x_studio_total_before_discount">-->
              <!--  <td class="amount" style="padding-right:10px;">-->
              <!--    <t t-esc="'{:.2f}'.format(line.product_qty * line.price_unit)"/>-->
              <!--  </td>-->
              <!--</t>-->
              <!--<t t-else="">-->
              <!--  <td class="amount" style="padding-right:10px;">-->
              <!--    <t t-esc="'{:.2f}'.format(line.price_subtotal)"/>-->
              <!--  </td>-->
              <!--</t>-->
            </tr>
            <t t-set="serial" t-value="serial + 1"/>
          </t>
        </t>
      </t>
      <t t-else="">
        <t t-set="serial" t-value="1"/>
        <t t-foreach="doc.order_line" t-as="line">
          <t t-if="line.display_type == 'line_section' and not line.is_downpayment">
            <tr style="background-color:#f2f2f2; font-weight:bold; text-transform: uppercase;padding: 3px 3px; !important">
              <td colspan="8" style="padding: 3px 3px; !important;text-align:left;">
                <t t-esc="line.name"/>
              </td>
            </tr>
          </t>

          <t t-if="line.display_type != 'line_section' and not line.is_downpayment">
            <tr>
              <td style="padding: 3px 3px; !important">
                <t t-esc="serial"/>
              </td>
              <td style="text-align:left;padding: 3px 3px; !important">
                <t t-esc="line.name or ''"/>
                 <t t-if="line.x_studio_remarks">
                    <div class="product_remark">
                      <span class="remark_label">Remark:</span>
                      <t t-esc="line.x_studio_remarks"/>
                    </div>
                  </t>
              </td>
              <td style="text-align:center;padding: 3px 3px; !important">
                <t t-esc="line.product_uom_id.name or ''"/>
              </td>
              <td style="text-align:center;padding: 3px 3px; !important">
                <t t-esc="'{:.2f}'.format((line.product_qty) or 0)"/>
              </td>
              <td style="text-align:center;padding: 3px 3px; !important">
                <t t-esc="'{:.2f}'.format((line.price_unit) or 0.0)"/>
              </td>


                <td class="amount" style=" padding-right:10px;">
                  <t t-esc="'{:.2f}'.format(line.price_subtotal)"/>
                </td>

              <td style="text-align:right !important;padding: 3px 3px; !important">
                <t t-esc="'{:.2f}'.format((line.price_total- line.price_subtotal) or 0.0)"/>
              </td>

                <td class="amount" style="padding-right:10px;">
                  <t t-esc="'{:.2f}'.format(line.price_total)"/>
                </td>

            </tr>
            <t t-set="serial" t-value="serial + 1"/>
          </t>
        </t>
      </t>

      </tbody>
      <t t-if="doc.x_studio_total_before_discount and abs(discount_amount) &gt; 0.0">
      <tr>
        <td colspan="3" rowspan="6" style="width:95%;text-align:center; vertical-align:middle;font-weight:bold;">
          <t t-set="amount_words" t-value="doc.currency_id.amount_to_text(doc.amount_total)"/> Amount in Words: <strong>
            <t t-esc="amount_words"/> Only (
            <t t-esc="doc.currency_id.name"/>)
          </strong>
        </td>
      </tr>
      <t t-set="discount_amount" t-value="abs((doc.x_studio_total_before_discount or 0.0) - (doc.amount_untaxed or 0.0))"/>
      <t t-if="doc.x_studio_total_before_discount and abs(discount_amount) &gt; 0.0">
        <tr>
          <td colspan="2" style="font-weight:bold;text-align:left;"> TOTAL </td>
          <td style="text-align:right;font-weight:bold; white-space: nowrap;">
            <span t-esc="'{:,.2f} {}'.format(                 doc.x_studio_total_before_discount or 0.0,                 doc.currency_id.symbol or ''             )"/>
          </td>
        </tr>
        <tr>
          <td colspan="2" style="font-weight:bold;text-align:left;"> DISCOUNT </td>
          <td style="text-align:right;font-weight:bold; white-space: nowrap;">
            <span t-esc="'{:,.2f} {}'.format(                 discount_amount,                 doc.currency_id.symbol or ''             )"/>
          </td>
        </tr>
      </t>

      <tr>
        <td colspan="2" style="font-weight:bold;text-align:left;"> TOTAL BEFORE VAT </td>
        <td style="text-align:right;font-weight:bold; white-space: nowrap;">
          <span t-esc="'{:,.2f} {}'.format(                 doc.amount_untaxed or 0.0,                 doc.currency_id.symbol or ''             )"/>
        </td>
      </tr>
      <tr>
        <td colspan="2" style="width:75%;font-weight:bold;text-align:left;">VAT</td>
        <td style="text-align:right;font-weight:bold; white-space: nowrap;">
          <span t-esc="'{:,.2f} {}'.format(doc.amount_tax, doc.currency_id.symbol or '')"/>
        </td>
      </tr>
      <tr>
        <td colspan="2" style="font-weight:bold;text-align:left;">TOTAL AFTER VAT</td>
        <td style="text-align:right;font-weight:bold; white-space: nowrap;">
          <span t-esc="'{:,.2f} {}'.format(doc.amount_total or 0.0, doc.currency_id.symbol or '')"/>
        </td>
      </tr>
      </t>
      <t t-else="">
           <tr>
        <td colspan="5" rowspan="6" style="width:95%;text-align:center; vertical-align:middle;font-weight:bold;">
          <t t-set="amount_words" t-value="doc.currency_id.amount_to_text(doc.amount_total)"/> Amount in Words: <strong>
            <t t-esc="amount_words"/> Only (
            <t t-esc="doc.currency_id.name"/>)
          </strong>
        </td>
      </tr>
      <t t-set="discount_amount" t-value="abs((doc.x_studio_total_before_discount or 0.0) - (doc.amount_untaxed or 0.0))"/>
      <t t-if="doc.x_studio_total_before_discount and abs(discount_amount) &gt; 0.0">
        <tr>
          <td colspan="2" style="font-weight:bold;text-align:left;"> TOTAL </td>
          <td style="text-align:right;font-weight:bold; white-space: nowrap;">
            <span t-esc="'{:,.2f} {}'.format(                 doc.x_studio_total_before_discount or 0.0,                 doc.currency_id.symbol or ''             )"/>
          </td>
        </tr>
        <tr>
          <td colspan="2" style="font-weight:bold;text-align:left;"> DISCOUNT </td>
          <td style="text-align:right;font-weight:bold; white-space: nowrap;">
            <span t-esc="'{:,.2f} {}'.format(                 discount_amount,                 doc.currency_id.symbol or ''             )"/>
          </td>
        </tr>
      </t>

      <tr>
        <td colspan="2" style="font-weight:bold;text-align:left;"> TOTAL BEFORE VAT </td>
        <td style="text-align:right;font-weight:bold; white-space: nowrap;">
          <span t-esc="'{:,.2f} {}'.format(                 doc.amount_untaxed or 0.0,                 doc.currency_id.symbol or ''             )"/>
        </td>
      </tr>
      <tr>
        <td colspan="2" style="width:75%;font-weight:bold;text-align:left;">VAT</td>
        <td style="text-align:right;font-weight:bold; white-space: nowrap;">
          <span t-esc="'{:,.2f} {}'.format(doc.amount_tax, doc.currency_id.symbol or '')"/>
        </td>
      </tr>
      <tr>
        <td colspan="2" style="font-weight:bold;text-align:left;">TOTAL AFTER VAT</td>
        <td style="text-align:right;font-weight:bold; white-space: nowrap;">
          <span t-esc="'{:,.2f} {}'.format(doc.amount_total or 0.0, doc.currency_id.symbol or '')"/>
        </td>
      </tr>
      </t>
    </table>

    <t t-if="doc.note">
      <div style="margin-top:20px; font-size:14px;">
        <span t-field="doc.note"/>
      </div>
    </t>
  </div>
  <div>
    <br/>
    <p style="text-align:center;font-size:12px">If you have any questions about this purchase order, please contact <br/>
      <t t-if="doc.company_id.email">
        <t t-esc="doc.company_id.phone"/> /
        <t t-esc="doc.company_id.email"/>
      </t>
    </p>
    <p style="text-align:center;font-size:12px"/>
  </div>
  <table>
    <tbody>
      <tr>
        <td colspan="8" style="padding: 40px; width: 100%;">
          <div style="width:100%; font-size:13px; overflow:hidden; page-break-inside: avoid;">
            <div style="float:left; width:33.33%; text-align:left;">AUTHORIZED SIGNATURE <br/>
              <!--<strong>-->
              <!--  <t t-esc="(doc.user_id.name or '').upper()" />-->
              <!--</strong>-->
            </div>
            <div style="float:left; width:20.33%; text-align:center;"/>
            <div style="float:left; width:55.33%; text-align:right;">ACCEPTANCE BY : <br/> NAME: <br/> SIGNATURE : </div>
          </div>
        </td>
      </tr>
    </tbody>
  </table>
</t>
        </t>
      </t>

  </template>
</odoo>