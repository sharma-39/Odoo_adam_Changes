<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_custom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.custom</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

       <xpath expr="//header/button[@name='print_quotation']" position="attributes">
    <attribute name="invisible">1</attribute>
</xpath>

<xpath expr="//header/button[@name='print_quotation']" position="after">
    <button name="%(action_report_custom_purchase)d"
            string="Print"
            type="action"
            class="oe_highlight"
            data-hotkey="y"  invisible="not x_studio_po_approve"/>
</xpath>
        </field>
    </record>
</odoo>