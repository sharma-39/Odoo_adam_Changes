<odoo>
    <record id="view_stock_picking_form_inherit_custom" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Add after Origin field -->
            <xpath expr="//field[@name='origin']" position="after">

                <group string="MR / PO Details">

                    <field name="x_studio_bom_request"/>

                    <field name="x_studio_mr_request_number"/>

                    <field name="x_studio_po_mr_number"/>

                    <field name="x_studio_po_number"/>

                </group>

            </xpath>

        </field>
    </record>
</odoo>